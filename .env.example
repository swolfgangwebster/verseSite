APP_ENV=production
HOST=0.0.0.0
PORT=8011
DATABASE_URL=sqlite:///verse_site.sqlite3
VERSE_SOURCE_PATH=versesAll.xlsx
VERSE_TRANSLATION=KJV
VERSE_IMPORT_ALWAYS=0
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=change-this-long-random-secret
SESSION_COOKIE_SECURE=1
SESSION_TTL_DAYS=30
PROCESSING_MODE=inline
STORAGE_BACKEND=local
MAX_PAGE_SIZE=25
POST_RATE_LIMIT_MAX=10
POST_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
