# Copy to .env.local. Development accounts are explicitly opt-in.
# APP_ENV=production disables all demo authentication, even if DEV_AUTH=true.
APP_ENV=development
DEV_AUTH=true
# Relative to this project, or an absolute path. Never expose this directory publicly.
DB_PATH=.data/verse.sqlite
# IANA timezone used for the stable daily passage calendar date.
SITE_TIMEZONE=America/New_York
# Exact browser origin required for mutations. Change with your port/hostname.
APP_ORIGIN=http://localhost:3000
# Only enable behind a proxy that overwrites x-forwarded-for itself.
TRUST_PROXY=false
# Optional Shopify configuration. Leave both blank for the labeled demo catalog.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Optional custom Shopify checkout host; HTTPS only, validated by the adapter.
SHOPIFY_CHECKOUT_DOMAIN=
